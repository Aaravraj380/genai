# Copy to .env to change any of these. Every setting is optional.

# Where the database lives (default: backend/data/focus_flow.db)
# DATABASE_URL=sqlite:///data/focus_flow.db

# Key that signs login tokens. Leave empty to auto-generate one into data/secret.key.
# SECRET_KEY=

# How many days a login lasts on a device
# ACCESS_TOKEN_DAYS=30

# Allowed web origins ("*" = any). Example: http://localhost:8081,http://192.168.1.20:8081
# CORS_ORIGINS=*

# Wrong-password lockout: attempts per email+IP within the window (seconds)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300
